# Keep private or potentially sensitive traffic data out of Git by default.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts can be large and may have separate licensing or handling rules.
artifacts/classifiers/*
!artifacts/classifiers/.gitkeep
artifacts/autoencoders/*
!artifacts/autoencoders/.gitkeep
artifacts/preprocessing/*
!artifacts/preprocessing/.gitkeep

database/*.db
database/*.sqlite*
*.log
